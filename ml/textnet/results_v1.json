  "rows": [
   {
    "text": "Mi-a murit pisica azi-noapte.",
    "gold": "sad",
    "net": "sad",
    "lexicon": "sad"
   },
   {
    "text": "Ieri a murit bunicul meu.",
    "gold": "sad",
    "net": "sad",
    "lexicon": "sad"
   },
   {
    "text": "Am aflat că fratele meu a murit.",
    "gold": "sad",
    "net": "surprise",
    "lexicon": "sad"
   },
   {
    "text": "Sunt atât de fericită că ai venit!",
    "gold": "joy",
    "net": "neutral",
    "lexicon": "joy"
   },
   {
    "text": "Am luat examenul cu nota zece!",
    "gold": "joy",
    "net": "joy",
    "lexicon": "sad"
   },
   {
    "text": "Ce bucurie să te văd!",
    "gold": "joy",
    "net": "neutral",
    "lexicon": "joy"
   },
   {
    "text": "Nu sunt deloc fericit azi.",
    "gold": "sad",
    "net": "sad",
    "lexicon": "joy"
   },
   {
    "text": "Nu mai sunt trist, mi-a trecut.",
    "gold": "neutral",
    "net": "neutral",
    "lexicon": "sad"
   },
   {
    "text": "Mi-e frică să merg singur noaptea.",
    "gold": "fear",
    "net": "neutral",
    "lexicon": "sad"
   },
   {
    "text": "Am auzit pași în casă și sunt îngrozit.",
    "gold": "fear",
    "net": "fear",
    "lexicon": "fear"
   },
   {
    "text": "M-a mințit din nou și sunt furios.",
    "gold": "anger",
    "net": "anger",
    "lexicon": "anger"
   },
   {
    "text": "Sunt supărat pe tine.",
    "gold": "anger",
    "net": "neutral",
    "lexicon": "anger"
   },
   {
    "text": "Nu-mi vine să cred ce s-a întâmplat!",
    "gold": "surprise",
    "net": "surprise",
    "lexicon": "surprise"
   },
   {
    "text": "Abia aștept vacanța, sunt foarte încântat!",
    "gold": "joy",
    "net": "joy",
    "lexicon": "joy"
   },
   {
    "text": "Am găsit un fir de păr în supă, ce scârbos.",
    "gold": "disgust",
    "net": "disgust",
    "lexicon": "disgust"
   },
   {
    "text": "Mi-e greață de mirosul ăsta.",
    "gold": "disgust",
    "net": "neutral",
    "lexicon": "sad"
   },
   {
    "text": "Se crede mai deștept decât toți, e penibil.",
    "gold": "contempt",
    "net": "contempt",
    "lexicon": "contempt"
   },
   {
    "text": "Am fost la magazin și am cumpărat pâine.",
    "gold": "neutral",
    "net": "neutral",
    "lexicon": "disgust"
   },
   {
    "text": "Mâine merg la serviciu cu autobuzul.",
    "gold": "neutral",
    "net": "neutral",
    "lexicon": "neutral"
   },
   {
    "text": "Mi-e frică, dar sunt bucuros că ești aici.",
    "gold": "joy",
    "net": "neutral",
    "lexicon": "joy"
   },
   {
    "text": "Am câștigat concursul, dar mi-a murit câinele.",
    "gold": "sad",
    "net": "sad",
    "lexicon": "sad"
   },
   {
    "text": "Eram trist, însă acum sunt fericit.",
    "gold": "joy",
    "net": "joy",
    "lexicon": "joy"
   },
   {
    "text": "Am pierdut portofelul în autobuz.",
    "gold": "sad",
    "net": "neutral",
    "lexicon": "sad"
   },
   {
    "text": "Am pierdut kilogramele în plus și mă simt minunat.",
    "gold": "joy",
    "net": "joy",
    "lexicon": "joy"
   },
   {
    "text": "Am primit o amendă uriașă.",
    "gold": "anger",
    "net": "anger",
    "lexicon": "neutral"
   },
   {
    "text": "Am primit o bursă la facultate!",
    "gold": "joy",
    "net": "joy",
    "lexicon": "neutral"
   },
   {
    "text": "M-a sunat spitalul azi-dimineață.",
    "gold": "fear",
    "net": "fear",
    "lexicon": "joy"
   },
   {
    "text": "Din păcate, nu am luat examenul.",
    "gold": "sad",
    "net": "neutral",
    "lexicon": "sad"
   },
   {
    "text": "Din fericire, totul s-a terminat cu bine.",
    "gold": "joy",
    "net": "neutral",
    "lexicon": "neutral"
   },
   {
    "text": "Sunt puțin îngrijorat pentru mâine.",
    "gold": "fear",
    "net": "neutral",
    "lexicon": "fear"
   },
   {
    "text": "Mă doare sufletul când mă gândesc la ea.",
    "gold": "sad",
    "net": "sad",
    "lexicon": "sad"
   },
   {
    "text": "Mi-e dor de mama.",
    "gold": "sad",
    "net": "sad",
    "lexicon": "sad"
   },
   {
    "text": "M-au concediat fără niciun motiv.",
    "gold": "sad",
    "net": "sad",
    "lexicon": "sad"
   },
   {
    "text": "Copilul nostru s-a născut azi!",
    "gold": "joy",
    "net": "joy",
    "lexicon": "joy"
   },
   {
    "text": "E dezgustător ce a făcut.",
    "gold": "disgust",
    "net": "disgust",
    "lexicon": "disgust"
   },
   {
    "text": "Sunt nervos pentru că m-au înșelat.",
    "gold": "anger",
    "net": "anger",
    "lexicon": "anger"
   },
   {
    "text": "A apărut un șarpe lângă cort!",
    "gold": "fear",
    "net": "fear",
    "lexicon": "fear"
   },
   {
    "text": "Ce zi minunată!",
    "gold": "joy",
    "net": "neutral",
    "lexicon": "neutral"
   },
   {
    "text": "Nu mi-e frică de nimic.",
    "gold": "neutral",
    "net": "neutral",
    "lexicon": "sad"
   },
   {
    "text": "Sunt obosit după o zi lungă.",
    "gold": "neutral",
    "net": "neutral",
    "lexicon": "neutral"
   }
  ]
 }
